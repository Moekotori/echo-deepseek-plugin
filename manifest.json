{
  "id": "echo.deepseek-details",
  "name": "DeepSeek 音乐资料",
  "version": "2.0.0",
  "apiVersion": 2,
  "minEchoVersion": "26.10.21",
  "entry": "plugin.js",
  "remoteModels": {
    "credentialKeys": [
      "openai-api-key",
      "anthropic-api-key"
    ]
  },
  "permissions": [
    "fs:plugin",
    "network:request",
    "library:read",
    "library:control",
    "playback:read",
    "covers:read",
    "queue:control",
    "agent:runtime",
    "background:run"
  ],
  "contributes": {
    "commands": [
      {
        "id": "configure-deepseek",
        "title": "DeepSeek 对话与歌单"
      },
      {
        "id": "research-contributor",
        "title": "DeepSeek 创作人员作品"
      }
    ],
    "panels": [
      {
        "id": "deepseek-settings",
        "title": "DeepSeek",
        "path": "panel.html",
        "placement": "page",
        "group": "plugins",
        "icon": "sparkles"
      }
    ],
    "metadataProviders": [
      {
        "id": "deepseek-artist",
        "title": "DeepSeek",
        "entity": "artist",
        "activationStorageKey": "api-key"
      },
      {
        "id": "deepseek-album",
        "title": "DeepSeek",
        "entity": "album",
        "activationStorageKey": "api-key",
        "contributorCommandId": "research-contributor"
      }
    ],
    "agents": [
      {
        "id": "daily-recommendations",
        "title": "每日音乐推荐"
      }
    ]
  }
}
